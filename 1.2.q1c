<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="ОказаниеУслуг">
		<text>ВЫБРАТЬ
	ОказаниеУслуг.Ссылка,
	ОказаниеУслуг.Клиент,
	ОказаниеУслуг.ИтоговаяСумма,
	ОказаниеУслуг.СписокНоменклатуры.(
		Ссылка,
		НомерСтроки,
		Номенклатура,
		Количество,
		Цена,
		Сумма
	)
ИЗ
	Документ.ОказаниеУслуг.СписокНоменклатуры КАК ОказаниеУслугСписокНоменклатуры
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОказаниеУслуг КАК ОказаниеУслуг
		ПО (ОказаниеУслугСписокНоменклатуры.Ссылка = ОказаниеУслуг.Ссылка)
</text>
		<textSQL>

		</textSQL>
		<planSQL>

		</planSQL>
		<typeSQL>

		</typeSQL>
	</query>
</querylist>